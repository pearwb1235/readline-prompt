{
  "name": "@pearwb/readline-prompt",
  "version": "0.1.1",
  "description": "A readline prompt that survives background console/logger output without losing what you're typing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "ts-node src",
    "test": "lint-staged && jest --passWithNoTests",
    "prepare": "husky",
    "build": "npm run build:script && npm run build:alias",
    "build:script": "tsc -p tsconfig.build.json",
    "build:alias": "tsc-alias -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "readline",
    "repl",
    "cli",
    "console",
    "prompt",
    "logger",
    "stdin",
    "stdout"
  ],
  "author": {
    "name": "pearwb1235",
    "email": "pear.wb1235@gmail.com",
    "url": "https://github.com/pearwb1235"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pearwb1235/readline-prompt.git"
  },
  "homepage": "https://github.com/pearwb1235/readline-prompt#readme",
  "bugs": {
    "url": "https://github.com/pearwb1235/readline-prompt/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
